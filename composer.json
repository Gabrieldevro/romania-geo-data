{
    "name": "gabrieldevro/romania-geo-data",
    "description": "All 42 Romanian counties and 13,755 localities with SIRUTA codes, postal codes, diacritics and search. JSON, CSV and SQL data plus a tiny PHP API. Official open data (INS + Posta Romana).",
    "keywords": ["romania", "judete", "localitati", "counties", "cities", "siruta", "postal-code", "cod-postal", "laravel", "checkout", "address"],
    "license": "MIT",
    "authors": [
        { "name": "Gabriel Conolache", "email": "contact@gabrieldev.eu", "homepage": "https://gabrieldev.eu" }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.5|^12.0"
    },
    "autoload": {
        "psr-4": { "Gabrieldev\\RomaniaGeo\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Gabrieldev\\RomaniaGeo\\Tests\\": "tests/" }
    },
    "archive": {
        "exclude": ["/sources", "/tools", "/test", "/node_modules"]
    },
    "scripts": { "test": "phpunit" },
    "minimum-stability": "stable",
    "prefer-stable": true
}
